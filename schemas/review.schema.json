{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "review",
  "description": "The agent's own review of a stage, written before its checkpoint. A pass with an open blocker is refused.",
  "type": "object",
  "required": ["stage", "looked_at", "findings", "checks_not_done", "verdict"],
  "properties": {
    "stage": { "type": "string", "minLength": 1 },
    "looked_at": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "The files, previews or links actually opened" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "where", "what", "fixed"],
        "properties": {
          "severity": { "enum": ["blocker", "should", "note"] },
          "where": { "type": "string", "minLength": 1 },
          "what": { "type": "string", "minLength": 1 },
          "fix": { "type": "string" },
          "fixed": { "type": "boolean" }
        }
      }
    },
    "checks_not_done": { "type": "array", "items": { "type": "string" }, "description": "Checks that could not be made (no browser, no access), stated plainly" },
    "verdict": { "enum": ["pass", "fail"] }
  }
}
