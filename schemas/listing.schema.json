{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "listing",
  "description": "The marketplace listing as the seller approved it.",
  "type": "object",
  "required": ["name", "title", "category", "price", "price_named_by", "status"],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 60 },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "category": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "price": { "type": "integer", "minimum": 0 },
    "price_named_by": { "const": "seller" },
    "status": { "enum": ["not_created", "draft", "published"] },
    "listing_id": { "type": "string" },
    "catalog_url": { "type": "string" },
    "live_preview_url": { "type": "string" },
    "left_for_dashboard": { "type": "array", "items": { "type": "string" } }
  }
}
