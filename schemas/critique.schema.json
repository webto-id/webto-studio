{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "critique",
  "description": "One blind critic pass over the screenshots of the real pages. Written by the critic, never edited by the builder. The tool computes the weighted overall.",
  "type": "object",
  "required": ["pass", "critic", "shots_at", "business_read", "idea_read", "scores", "fixes"],
  "properties": {
    "pass": { "type": "integer", "minimum": 1 },
    "critic": { "enum": ["subagent", "self"], "description": "subagent: a fresh agent that saw only the evidence. self: the builder scored its own work" },
    "shots_at": { "type": "string", "minLength": 1, "description": "The `at` of shots/index.json the critic judged, copied from the brief" },
    "business_read": { "type": "string", "minLength": 10, "description": "What and where the critic thinks the business is, from the first screens alone" },
    "idea_read": { "type": "string", "minLength": 10, "description": "The site's idea in one sentence, as the critic read it, or a plain statement that no idea came through" },
    "scores": {
      "type": "object",
      "required": ["design", "usability", "distinctiveness", "content"],
      "properties": {
        "design": { "$ref": "#/definitions/score" },
        "usability": { "$ref": "#/definitions/score" },
        "distinctiveness": { "$ref": "#/definitions/score" },
        "content": { "$ref": "#/definitions/score" }
      }
    },
    "fixes": {
      "type": "array",
      "description": "Most score gained first",
      "items": {
        "type": "object",
        "required": ["criterion", "file", "what", "change"],
        "properties": {
          "criterion": { "enum": ["design", "usability", "distinctiveness", "content"] },
          "file": { "type": "string", "minLength": 1 },
          "what": { "type": "string", "minLength": 8 },
          "change": { "type": "string", "minLength": 8 }
        }
      }
    },
    "not_judged": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "score": {
      "type": "object",
      "required": ["score", "evidence"],
      "properties": {
        "score": { "type": "number", "minimum": 1, "maximum": 10 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["file", "note"],
            "properties": {
              "file": { "type": "string", "pattern": "^shots/" },
              "note": { "type": "string", "minLength": 5 }
            }
          }
        }
      }
    }
  }
}
