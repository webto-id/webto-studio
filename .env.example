# Everything here is optional except the token, and the token does NOT go in
# this file: set it as an environment variable of your shell.
#
#   macOS / Linux:  export WEBTO_TOKEN="wbt_..."
#   Windows:        setx WEBTO_TOKEN "wbt_..."   (then open a new terminal)
#
# Create it in the dashboard: Settings -> Security -> Access tokens (AI agent).
# Never paste the token into a chat with the agent.

# Point the tools at another deployment (a staging stack, for instance).
# The agent's own MCP connection reads .mcp.json: run `npm run setup` after
# changing this so both agree.
# WEBTO_MCP_URL=https://api.webto.id/mcp
