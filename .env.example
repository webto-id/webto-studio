# Copy this file to .env and fill in what you use. .env is ignored by git.
# Everything here is optional.

# ---------------------------------------------------------------------------
# The platform token does NOT go in this file. The agent's MCP connection
# reads it from your shell, so set it there:
#
#   macOS / Linux:  export WEBTO_TOKEN="wbt_..."
#   Windows:        setx WEBTO_TOKEN "wbt_..."   (then open a new terminal)
#
# Create it in the dashboard: Settings -> Security -> Access tokens (AI agent).
# Never paste the token into a chat with the agent.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Stock photo search (optional, free keys)
#
# Without a key the platform already picks a stock photo for every
# `__IMG__:<query>` stand-in. With a key, the agent can search a library
# itself, look at the candidates and choose the photo (`studio stock`).
# ---------------------------------------------------------------------------

# Which library to search when more than one key is set:
# unsplash | pexels | pixabay. Empty = the first one below that has a key.
STOCK_PROVIDER=

# Unsplash. "Access Key" of an app: https://unsplash.com/oauth/applications
# Photos are shown from Unsplash's own address and need a visible credit.
# A new app is limited to 50 searches an hour.
UNSPLASH_ACCESS_KEY=

# Pexels. Key: https://www.pexels.com/api/
# Photos are downloaded into the site. Pexels asks for a credit where it fits.
PEXELS_API_KEY=

# Pixabay. Key: https://pixabay.com/api/docs/ (shown when logged in)
# Photos are downloaded into the site. No credit is required on the site.
PIXABAY_API_KEY=

# ---------------------------------------------------------------------------
# Image generation (optional)
#
# For agents that cannot make images themselves. Set ONE key and the agent can
# generate photos and illustrations with `studio image`. With no key, sites
# use your own images or stock stand-ins, and nothing is billed.
#
# Images are billed to your own account with the provider. The agent tells
# you the provider, the model and how many images before it makes the first.
# ---------------------------------------------------------------------------

# Which provider to use when more than one key is set:
# gemini | openrouter | openai | fal. Empty = the first one below that has a key.
IMAGE_PROVIDER=

# Google AI Studio (Gemini). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Other image models: gemini-2.5-flash-image, gemini-3-pro-image
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# OpenRouter: one key, many image models. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model listed at https://openrouter.ai/api/v1/images/models, for example
# black-forest-labs/flux.2-pro, bytedance-seed/seedream-4.5
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# OpenAI. Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# fal.ai. Key: https://fal.ai/dashboard/keys
FAL_KEY=
# FLUX family models. Other fal models may take different input fields.
FAL_IMAGE_MODEL=fal-ai/flux/schnell

# ---------------------------------------------------------------------------
# The blind critic (optional)
#
# After the draft is on the platform, a fresh agent scores the screenshots
# and its fixes are worked through. It is paid in your agent's tokens: in the
# demo runs about a tenth of a client site and a quarter to a third of a
# template. Choose how much of it you want for every new project:
#
#   full  a fresh critic per pass until the site meets the bar (default)
#   once  one fresh critic; its fixes are made but not judged again
#   self  the agent scores its own screenshots once (not independent)
#   off   no critic; the agent's own review and the measurements only
#
# A template for sale always gets at least "once". One project can differ:
# ask the agent ("tanpa kritikus untuk situs ini").
# ---------------------------------------------------------------------------
STUDIO_CRITIC=

# ---------------------------------------------------------------------------
# Advanced
# ---------------------------------------------------------------------------

# Point the tools at another deployment (a staging stack, for instance).
# Run `npm run setup` after changing this so .mcp.json agrees.
# WEBTO_MCP_URL=https://api.webto.id/mcp
