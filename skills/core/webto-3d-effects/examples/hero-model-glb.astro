---
import { img, url, Button, EditUrlPill } from "webto/variant";

interface Props {
  /** Small label above the headline, ≤6 words. @example Madu hutan · Kalimantan */
  badge?: string;
  /** The product name, ≤4 words. @example Madu Kelulut */
  headline?: string;
  /** One sentence, ≤22 words. @example Dipanen tangan dari sarang lebah tanpa sengat, langsung dari hutan ke toples. */
  subheadline?: string;
  ctaText?: string;
  ctaUrl?: string;
  /** The 3D model of the product: a .glb file (max 10 MB) uploaded in the editor. Leave empty to show only the poster photo. @example /samples/models/jar.glb */
  modelUrl?: string;
  /** Poster photo of the same product, shown in the editor, while the model loads, and wherever 3D is off. @example /r2/s/toples.webp */
  imageUrl?: string;
  /** Alt text of the poster photo. @example Toples madu kelulut */
  imageAlt?: string;
}

const {
  badge,
  headline,
  subheadline,
  ctaText = "Pesan",
  ctaUrl = "#",
  modelUrl = "",
  imageUrl = "",
  imageAlt = "",
} = Astro.props;
const poster = img(imageUrl, 1200);
---
<section class="relative h-[200vh] bg-background text-foreground">
  <div class="sticky top-0 grid h-screen items-center gap-8 overflow-hidden px-6 py-16 md:grid-cols-2 md:px-12">
    <div class="relative z-10 order-2 max-w-xl md:order-1">
      {badge && <p data-edit-field="badge" class="mb-4 text-xs font-semibold uppercase tracking-widest text-muted-foreground">{badge}</p>}
      <h1 data-edit-field="headline" class="!text-5xl font-black leading-[0.95] tracking-tight text-primary-text sm:!text-7xl" style="font-family: var(--font-heading);">{headline}</h1>
      {subheadline && <p data-edit-field="subheadline" class="mt-5 text-base text-muted-foreground sm:text-lg">{subheadline}</p>}
      {ctaText && (
        <Button href={url(ctaUrl)} size="lg" class="relative mt-7 rounded-full">
          <span data-edit-field="ctaText">{ctaText}</span>
          <EditUrlPill field="ctaUrl" value={ctaUrl} />
        </Button>
      )}
    </div>
    <div data-stage data-model={modelUrl} data-edit-model="modelUrl" class="relative order-1 mx-auto aspect-square w-full max-w-[min(80vw,560px)] md:order-2">
      <div aria-hidden="true" class="absolute inset-[12%] rounded-full bg-primary/15 blur-2xl"></div>
      {poster ? (
        <img data-poster src={poster} alt={imageAlt} data-edit-image="imageUrl" class="relative h-full w-full object-contain transition-opacity duration-500" />
      ) : (
        <div data-edit-image="imageUrl" class="relative h-full w-full rounded-2xl border-2 border-dashed border-border bg-muted"></div>
      )}
      <div data-gl class="absolute inset-0" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script is:inline data-uses="gsap scroll-trigger three">
  if (root.dataset.wvInit) return;
  root.dataset.wvInit = "1";
  const stage = root.querySelector("[data-stage]");
  const host = root.querySelector("[data-gl]");
  const poster = root.querySelector("[data-poster]");
  // Scroll progress drives the turn; GSAP only, so the numbers exist without WebGL too.
  const spin = { p: 0 };
  gsap.context(() => {
    gsap.to(spin, { p: 1, ease: "none", scrollTrigger: { trigger: root, start: "top top", end: "bottom bottom", scrub: 0.6 } });
  }, root);

  // No WebGL, the editor, reduced motion, or no model uploaded: the poster stays.
  if (!THREE || !stage || !host || !stage.getAttribute("data-model")) return;

  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
  renderer.setPixelRatio(window.devicePixelRatio);
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  const scene = new THREE.Scene();
  // Metal and glass need something to reflect, or they render black.
  const pmrem = new THREE.PMREMGenerator(renderer);
  scene.environment = pmrem.fromScene(new THREE.RoomEnvironment(), 0.04).texture;
  const camera = new THREE.PerspectiveCamera(30, 1, 0.01, 100);
  scene.add(new THREE.HemisphereLight(0xffffff, 0x8a7a66, 0.8));
  const key = new THREE.DirectionalLight(0xffffff, 1.6);
  key.position.set(3, 4, 5);
  scene.add(key);
  const rim = new THREE.DirectionalLight(0xffffff, 1.2);
  rim.position.set(-4, 2, -3);
  scene.add(rim);

  const pivot = new THREE.Group();
  scene.add(pivot);
  const tilt = { x: 0, y: 0 };
  stage.addEventListener("pointermove", (e) => {
    const r = stage.getBoundingClientRect();
    tilt.x = ((e.clientY - r.y) / r.height - 0.5) * 0.25;
    tilt.y = ((e.clientX - r.x) / r.width - 0.5) * 0.5;
  });
  stage.addEventListener("pointerleave", () => { tilt.x = 0; tilt.y = 0; });

  function fit() {
    const w = stage.clientWidth;
    const h = stage.clientHeight;
    renderer.setSize(w, h, false);
    renderer.domElement.style.width = "100%";
    renderer.domElement.style.height = "100%";
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }

  THREE.loadModel(stage).then((gltf) => {
    const model = gltf.scene;
    // Centre the model and scale it to a unit size, whatever units it was exported in.
    const box = new THREE.Box3().setFromObject(model);
    const size = box.getSize(new THREE.Vector3());
    const centre = box.getCenter(new THREE.Vector3());
    model.position.sub(centre);
    const s = 1.6 / Math.max(size.x, size.y, size.z);
    pivot.scale.setScalar(s);
    pivot.add(model);
    camera.position.set(0, 0.25, 4.2);
    camera.lookAt(0, 0, 0);
    host.appendChild(renderer.domElement);
    fit();
    new ResizeObserver(fit).observe(stage);
    let t0 = 0;
    function frame(t) {
      requestAnimationFrame(frame);
      const idle = (t - t0) * 0.00015;
      pivot.rotation.y += ((spin.p * Math.PI * 2 + idle + tilt.y) - pivot.rotation.y) * 0.08;
      pivot.rotation.x += (tilt.x - pivot.rotation.x) * 0.08;
      renderer.render(scene, camera);
    }
    requestAnimationFrame((t) => {
      t0 = t;
      frame(t);
      // The poster fades only once the model has drawn.
      if (poster) poster.style.opacity = "0";
    });
  }).catch(() => {
    // A broken or refused file: keep the poster.
  });
</script>
